{
  "name": "agentic-ucp-scanner",
  "version": "1.0.0",
  "description": "Zero-runtime-dependency Node.js and TypeScript CLI and library for inspecting websites and local fixtures for machine-readable commerce signals.",
  "keywords": [
    "ucp",
    "agentic-commerce",
    "ai-agents",
    "machine-trust",
    "json-ld",
    "llms-txt",
    "robots-txt",
    "schema-org",
    "autonomous-checkout",
    "nymrel"
  ],
  "author": "Nymrel <contact@nymrel.com>",
  "license": "MIT",
  "homepage": "https://github.com/nymrel/agentic-ucp-scanner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nymrel/agentic-ucp-scanner.git"
  },
  "bugs": {
    "url": "https://github.com/nymrel/agentic-ucp-scanner/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ucp-audit": "./bin/ucp-audit.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt",
    "test/fixtures"
  ],
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node ./bin/ucp-audit.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck",
    "test": "npm run build && node ./scripts/run-tests.mjs",
    "test:coverage": "npm run build && node ./scripts/run-tests.mjs --coverage",
    "security:audit": "npm audit --audit-level=high",
    "security:signatures": "npm audit signatures",
    "package:check": "node ./scripts/check-package.mjs",
    "check": "npm run typecheck && npm run test && npm run security:audit && npm run security:signatures && npm run package:check",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || ^26.0.0",
    "npm": ">=11.6.0 <13"
  },
  "packageManager": "npm@11.19.1+sha512-ztsxKxt/kkIaAs+2i0GU6I+DRmUdrNasxTZKJe9TCdSjKxlhah/4r/hl5ygMD6XAg1qZ9c2TNomR4qgOydp10g==",
  "publishConfig": {
    "access": "public"
  }
}
